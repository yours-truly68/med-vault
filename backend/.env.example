# Application
APP_NAME=MedVault API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://medvault:changeme@localhost:5432/medvault

# Security
SECRET_KEY=changeme-generate-a-secure-key
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# File storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# AI providers
OPENAI_API_KEY=
EMBEDDING_MODEL=
LLM_MODEL=
