# AI providers
# LLM_PROVIDER=openai|groq|vercel|ollama|local|openai_compatible
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GROQ_API_KEY=
VERCEL_AI_API_KEY=
OLLAMA_API_KEY=

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Processing worker
DOCUMENT_WORKER_CONCURRENCY=2
OCR_PDF_DPI=150
OCR_MAX_WORKERS=4
EMBEDDING_RETRY_BASE_SECONDS=60
EMBEDDING_RETRY_MAX_SECONDS=900
DEFERRED_RETRY_POLL_SECONDS=30
