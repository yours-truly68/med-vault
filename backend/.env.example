# AI providers — see root `.env.example` for the full template.
# Provider names only in *_PROVIDER; model ids only in *_MODEL.

LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:latest
LLM_API_KEY=
LLM_BASE_URL=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
VERCEL_AI_API_KEY=
VERCEL_BASE_URL=https://ai-gateway.vercel.sh/v1
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

OLLAMA_HOST=http://localhost:11434
OLLAMA_API_KEY=

CLASSIFICATION_PROVIDER=ollama
CLASSIFICATION_MODEL=llama3.2:latest
CLASSIFICATION_FALLBACK_PROVIDER=
CLASSIFICATION_FALLBACK_MODEL=

METADATA_PROVIDER=ollama
METADATA_MODEL=llama3.2:latest
METADATA_FALLBACK_PROVIDER=
METADATA_FALLBACK_MODEL=

SUMMARY_PROVIDER=gemini
SUMMARY_MODEL=gemini-2.0-flash

CHAT_PROVIDER=xai
CHAT_MODEL=grok-2-1212

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_FALLBACK_PROVIDER=
EMBEDDING_FALLBACK_MODEL=

GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

AI_ROUTER_MAX_RETRIES=3
AI_ROUTER_BASE_DELAY_SECONDS=2
AI_ROUTER_MAX_DELAY_SECONDS=60
AI_HEALTH_CHECK_TTL_SECONDS=60

DOCUMENT_WORKER_CONCURRENCY=2
OCR_PDF_DPI=150
OCR_MAX_WORKERS=4
OCR_LANGUAGE=eng
TESSERACT_ENABLED=true
TESSERACT_CMD=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
ARQ_JOB_TIMEOUT=300
ARQ_MAX_RETRIES=3
PROCESSING_QUEUE_NAME=medvault:processing
INDEXING_QUEUE_NAME=medvault:indexing

EMBEDDING_RETRY_BASE_SECONDS=60
EMBEDDING_RETRY_MAX_SECONDS=900
DEFERRED_RETRY_POLL_SECONDS=30

EXTRACTION_CACHE_ENABLED=true
EXTRACTION_CACHE_DIR=./.cache/extraction
EXTRACTION_QUALITY_ACCEPT_THRESHOLD=0.9
EXTRACTION_QUALITY_WARN_THRESHOLD=0.6
EXTRACTION_TIMEOUT_SECONDS=60

DOCLING_ENABLED=false
DOCLING_TIMEOUT_SECONDS=120
PRIMARY_PDF_EXTRACTOR=pymupdf
SECONDARY_PDF_EXTRACTOR=docling
IMAGE_EXTRACTOR=tesseract
