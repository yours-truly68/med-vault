# =============================================================================
# MedVault environment template
# Copy to `.env` at the repo root and fill in values.
# Backend also accepts `backend/.env` (root wins for shared keys).
# Do not put spaces around `=` (use KEY=value, not KEY = value).
# =============================================================================

# -----------------------------------------------------------------------------
# Docker Compose Postgres (used by docker-compose.yml)
# -----------------------------------------------------------------------------
POSTGRES_USER=medvault
POSTGRES_PASSWORD=changeme
POSTGRES_DB=medvault

# -----------------------------------------------------------------------------
# Application (required)
# -----------------------------------------------------------------------------
# development | staging | production
ENVIRONMENT=development
DEBUG=false
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Async SQLAlchemy URL (asyncpg). Match host/port to your Postgres.
# Docker Compose default: localhost:5432
# Local custom mappings often use 5433
DATABASE_URL=postgresql+asyncpg://medvault:changeme@localhost:5432/medvault

# JWT signing secret — generate a long random string for anything beyond local demo
SECRET_KEY=changeme-generate-a-secure-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_COOKIE_PATH=/auth

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# File storage (required)
# -----------------------------------------------------------------------------
# Relative paths resolve from the process working directory (usually backend/)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# -----------------------------------------------------------------------------
# Frontend (required for Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# AI / LLM — primary provider (required for classify, summary, chat, embeddings)
# -----------------------------------------------------------------------------
# Provider id used when task-specific *_PROVIDER is unset:
#   openai | vercel | groq | gemini | xai | ollama | local
LLM_PROVIDER=openai

# API key for OpenAI-compatible chat/embeddings.
# For Vercel AI Gateway, paste the gateway key here (often starts with vck_).
OPENAI_API_KEY=

# Optional aliases / overrides (any one key can satisfy OpenAI-compatible providers)
# LLM_API_KEY=
# VERCEL_AI_API_KEY=
# GROQ_API_KEY=
# LOCAL_LLM_API_KEY=

# Chat completions / gateway base URL (prefer VERCEL_BASE_URL for Vercel AI Gateway)
VERCEL_BASE_URL=https://ai-gateway.vercel.sh/v1
# Legacy alias (deprecated): DEFAULT_BASE_URL
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_BASE_URL=

LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# -----------------------------------------------------------------------------
# Embeddings (required for RAG / chat)
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT_SECONDS=60

# Rate-limit deferral for embedding jobs (seconds)
EMBEDDING_RETRY_BASE_SECONDS=60
EMBEDDING_RETRY_MAX_SECONDS=900
DEFERRED_RETRY_POLL_SECONDS=30

# -----------------------------------------------------------------------------
# RAG / chat tuning (optional)
# -----------------------------------------------------------------------------
RAG_TOP_K=5
RAG_MIN_SCORE=0.15

# -----------------------------------------------------------------------------
# Task-specific AI routing (provider names only — models go in *_MODEL)
# Providers: openai | vercel | groq | gemini | xai | ollama | local
# -----------------------------------------------------------------------------
CLASSIFICATION_PROVIDER=
CLASSIFICATION_MODEL=
# CLASSIFICATION_FALLBACK_PROVIDER=
# CLASSIFICATION_FALLBACK_MODEL=

METADATA_PROVIDER=
METADATA_MODEL=
# METADATA_FALLBACK_PROVIDER=
# METADATA_FALLBACK_MODEL=

SUMMARY_PROVIDER=
SUMMARY_MODEL=
# SUMMARY_FALLBACK_PROVIDER=
# SUMMARY_FALLBACK_MODEL=

VISION_PROVIDER=
VISION_MODEL=
# VISION_FALLBACK_PROVIDER=
# VISION_FALLBACK_MODEL=

CHAT_PROVIDER=
CHAT_MODEL=
# CHAT_FALLBACK_PROVIDER=
# CHAT_FALLBACK_MODEL=

# EMBEDDING_FALLBACK_PROVIDER=
# EMBEDDING_FALLBACK_MODEL=

# -----------------------------------------------------------------------------
# Optional providers
# -----------------------------------------------------------------------------
# Gemini (native API — required when *_PROVIDER=gemini)
# GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_VISION_MODEL=gemini-2.0-flash
GEMINI_VISION_TIMEOUT_SECONDS=90
GEMINI_VISION_MAX_PAGES=20

# xAI (Grok)
# XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Ollama (local)
OLLAMA_HOST=http://localhost:11434
# OLLAMA_API_KEY=

# AI router tuning
AI_ROUTER_MAX_RETRIES=3
AI_ROUTER_BASE_DELAY_SECONDS=2
AI_ROUTER_MAX_DELAY_SECONDS=60
AI_HEALTH_CHECK_TTL_SECONDS=60

# -----------------------------------------------------------------------------
# Document extraction engine (optional — defaults are production-safe)
# -----------------------------------------------------------------------------
DOCUMENT_WORKER_CONCURRENCY=2

# Tesseract OCR (scanned PDFs / images). Leave TESSERACT_CMD empty to use PATH.
TESSERACT_ENABLED=true
OCR_LANGUAGE=eng
# TESSERACT_CMD=
OCR_PDF_DPI=150
OCR_MIN_NATIVE_TEXT_CHARS=20
OCR_MAX_WORKERS=4

EXTRACTION_CACHE_ENABLED=true
EXTRACTION_CACHE_DIR=./.cache/extraction
# EXTRACTION_CACHE_TTL_SECONDS=
EXTRACTION_QUALITY_ACCEPT_THRESHOLD=0.9
EXTRACTION_QUALITY_WARN_THRESHOLD=0.6
EXTRACTION_ALLOW_LOW_QUALITY_LAST_RESORT=false
EXTRACTION_TIMEOUT_SECONDS=60

# Extractors (names: pymupdf | docling | tesseract | gemini)
PRIMARY_PDF_EXTRACTOR=pymupdf
SECONDARY_PDF_EXTRACTOR=docling
IMAGE_EXTRACTOR=tesseract
VISION_FALLBACK=gemini

# Optional Docling extractor (heavy; off by default)
DOCLING_ENABLED=false
DOCLING_TIMEOUT_SECONDS=120
