# PostgreSQL
POSTGRES_USER=medvault
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=medvault
DATABASE_URL=postgresql+asyncpg://medvault:your_secure_password@localhost:5432/medvault

# Backend
SECRET_KEY=your_secure_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000

# File storage
UPLOAD_DIR=./backend/uploads
MAX_UPLOAD_SIZE_MB=25

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI providers (configure as needed)
OPENAI_API_KEY=your_openai_api_key
EMBEDDING_MODEL="text-embedding-3-small"
DEFAULT_BASE_URL="https://ai-gateway.vercel.sh/v1"
LLM_MODEL="gpt-4o-mini"

# Legacy global LLM defaults
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:latest
LLM_API_KEY=
LLM_BASE_URL=

GROQ_API_KEY=your_groq_api_key
VERCEL_AI_API_KEY=your_vercel_api_key
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# Ollama (local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_API_KEY=

# Task-specific AI routing
CLASSIFICATION_PROVIDER=ollama
CLASSIFICATION_MODEL=llama3.2:latest
CLASSIFICATION_FALLBACK_PROVIDER=groq
CLASSIFICATION_FALLBACK_MODEL=llama-3.3-70b-versatile

METADATA_PROVIDER=ollama
METADATA_MODEL=llama3.2:latest
METADATA_FALLBACK_PROVIDER=groq
METADATA_FALLBACK_MODEL=llama-3.3-70b-versatile

SUMMARY_PROVIDER=vercel
SUMMARY_MODEL=google/gemini-2.5-flash

VISION_PROVIDER=vercel
VISION_MODEL=google/gemini-2.5-flash

CHAT_PROVIDER=groq
CHAT_MODEL=llama-3.3-70b-versatile

# Embeddings
EMBEDDING_PROVIDER=vercel
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=your_embedding_api_key
EMBEDDING_BASE_URL=https://api.vercel.sh/v1
EMBEDDING_FALLBACK_PROVIDER=
EMBEDDING_FALLBACK_MODEL=
EMBEDDING_FALLBACK_API_KEY=
EMBEDDING_FALLBACK_BASE_URL=

# Extraction Engine
EXTRACTION_CACHE_ENABLED=true
EXTRACTION_CACHE_DIR=./.cache/extraction
EXTRACTION_QUALITY_ACCEPT_THRESHOLD=0.9
EXTRACTION_QUALITY_WARN_THRESHOLD=0.6
DOCLING_TIMEOUT_SECONDS=120

############################################################
# Background Processing
############################################################
DOCUMENT_WORKER_CONCURRENCY=2
OCR_PDF_DPI=150
OCR_MAX_WORKERS=2
EMBEDDING_RETRY_BASE_SECONDS=60
EMBEDDING_RETRY_MAX_SECONDS=900
DEFERRED_RETRY_POLL_SECONDS=2

############################################################
# Extraction Engine Config
############################################################
EXTRACTION_TIMEOUT_SECONDS=60

############################################################
# Extractors
############################################################
DOCLING_ENABLED=true
PRIMARY_PDF_EXTRACTOR=pymupdf
SECONDARY_PDF_EXTRACTOR=docling
IMAGE_EXTRACTOR=tesseract
VISION_FALLBACK=gemini

############################################################
# OCR
############################################################
OCR_LANGUAGE=eng
TESSERACT_ENABLED=true
TESSERACT_CMD=/opt/homebrew/bin/tesseract
